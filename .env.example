# ReIn Komputer Environment Configuration Example
# Salin berkas ini ke .env dan isi nilai yang sesuai.
# JANGAN PERNAH menyimpan token rahasia ke repositori git.

# Telegram Bot Token (dari BotFather)
TELEGRAM_BOT_TOKEN=

# Kunci HMAC untuk anonimisasi log dan privasi pelanggan (WAJIB di mode operasional)
LOG_HMAC_KEY=

# Rahasia JWT untuk otentikasi dashboard admin
JWT_SECRET_KEY=

# Konfigurasi Server FastAPI
FASTAPI_PORT=8000

# Model LLM yang digunakan
CHAT_LLM_MODEL=gemma4:e4b

# Mode Chat Engine ("antigravity_v2" | "dynamic_rag" | "agentic_tool")
CHAT_ENGINE_MODE=antigravity_v2

# Qdrant Collections
QDRANT_PRODUCTS_COLLECTION=computer_products
QDRANT_KNOWLEDGE_COLLECTION=computer_knowledge

# Ambang Batas Kesamaan Kosinus RAG (Default: 0.40)
RAG_SCORE_THRESHOLD=0.40

# Kontak Staf Fiktif Toko
KONTAK_STAF="staf toko kami"

# Tombol umpan balik jempol (👍/👎) pada balasan bot Telegram (1 = aktif, 0 = nonaktif/default mati)
FEEDBACK_BUTTONS=0

